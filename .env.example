# 本地端口约定（避免冲突）：
# life-design-backend   → 3000
# huodongxing-backend   → 3001
# life-design-admin     → 5173（见 vite.config.ts）

# 后台 Auth Mock：生产必须为 false
VITE_AUTH_MOCK=false

# 后台 API Base URL（不含末尾斜杠；请求路径自带 /api/...）
# 本地联调 life-design-backend：http://127.0.0.1:3000
VITE_API_BASE_URL=http://127.0.0.1:3000

# 探索活动后端 Base URL（huodongxing-backend；仅供 Events Token 使用）
# 本地联调 huodongxing-backend：http://127.0.0.1:3001
VITE_EVENTS_API_BASE_URL=http://127.0.0.1:3001

# Vite 开发服务器 /api 代理目标（可选，默认同 VITE_API_BASE_URL）
VITE_API_TARGET=http://127.0.0.1:3000

# 部署子路径；Vercel 独立域名可设为 /
# VITE_BASE_PATH=/admin/

# 主办方外部后台地址（organizer 登录后跳转，可选）
# VITE_ORGANIZER_ADMIN_URL=https://example.com/organizer-admin
